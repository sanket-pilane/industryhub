{
  "name": "industrihub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web -- --hostname 127.0.0.1",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test --workspace web",
    "format": "prettier --write web/app web/components web/lib web/tests web/proxy.ts shared docs README.md",
    "format:check": "prettier --check web/app web/components web/lib web/tests web/proxy.ts shared docs README.md"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
