{
  "openapi": "3.0.3",
  "info": {
    "title": "INDUSTRIHUB Phase 0 local API",
    "version": "0.1.0",
    "description": "Local mock scaffold only. Catalyst and commerce write workflows remain future phases."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100",
      "description": "Local production preview used by Playwright"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service readiness"
    },
    {
      "name": "Catalog",
      "description": "Public demo catalog"
    },
    {
      "name": "Session",
      "description": "Local demo session and profile"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check service configuration",
        "operationId": "getHealth",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "object",
                      "required": ["service", "mode", "environment"],
                      "properties": {
                        "service": {
                          "type": "string",
                          "enum": ["INDUSTRIHUB"]
                        },
                        "mode": {
                          "type": "string",
                          "enum": ["mock", "catalyst"]
                        },
                        "environment": {
                          "type": "string",
                          "enum": ["development", "production"]
                        }
                      }
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Search and paginate products",
        "operationId": "listProducts",
        "tags": ["Catalog"],
        "responses": {
          "200": {
            "description": "Paginated products; totals are in meta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Adapter unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "q catalog query parameter.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "category catalog query parameter.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "description": "group catalog query parameter.",
            "schema": {
              "type": "string",
              "enum": ["mechanical", "electrical", "automation", "tools"]
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "brand catalog query parameter.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "inStock",
            "in": "query",
            "required": false,
            "description": "inStock catalog query parameter.",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "sort catalog query parameter.",
            "schema": {
              "type": "string",
              "enum": ["relevance", "newest", "price_asc", "price_desc"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "page catalog query parameter.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "pageSize catalog query parameter.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          }
        ]
      }
    },
    "/api/products/{slug}": {
      "get": {
        "summary": "Get a product by slug",
        "operationId": "getProduct",
        "tags": ["Catalog"],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Product"
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Adapter unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Product URL slug.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/categories": {
      "get": {
        "summary": "List all demo categories",
        "operationId": "listCategories",
        "tags": ["Catalog"],
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Adapter unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Read the current session-owned profile",
        "operationId": "getMe",
        "tags": ["Session"],
        "security": [
          {
            "DemoCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserProfile"
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/mock/session": {
      "post": {
        "summary": "Create a fixed demo-customer session",
        "operationId": "createDemoSession",
        "tags": ["Session"],
        "description": "Mock mode only. Exact same Origin/Host required. Credentials are public local-demo values. Issues a signed HTTP-only SameSite=Lax cookie; remember=true persists 7 days, otherwise browser session with 8-hour signed expiry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "remember"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "remember": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "object",
                      "required": ["signedIn"],
                      "properties": {
                        "signedIn": {
                          "type": "boolean",
                          "enum": [true]
                        }
                      }
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Invalid demo credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Origin mismatch or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not in mock mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Clear the demo session",
        "operationId": "deleteDemoSession",
        "tags": ["Session"],
        "description": "Mock mode only; exact same Origin/Host required.",
        "responses": {
          "200": {
            "description": "Session cleared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data", "error", "meta"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "object",
                      "required": ["signedIn"],
                      "properties": {
                        "signedIn": {
                          "type": "boolean",
                          "enum": [false]
                        }
                      }
                    },
                    "error": {
                      "nullable": true,
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origin mismatch or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not in mock mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "industrihub-demo-session",
        "description": "Local demonstration only; not Catalyst authentication."
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "sku",
          "name",
          "category",
          "brand",
          "description",
          "pricePaise",
          "gstPercent",
          "stockQuantity",
          "specifications",
          "image",
          "symbol",
          "featured"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "pricePaise": {
            "type": "integer",
            "minimum": 0,
            "description": "Integer paise, excluding GST."
          },
          "gstPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "stockQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "specifications": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "symbol": {
            "type": "string"
          },
          "featured": {
            "type": "boolean"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": ["slug", "name", "group"],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": ["mechanical", "electrical", "automation", "tools"]
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": [
          "id",
          "role",
          "firstName",
          "lastName",
          "initials",
          "email",
          "phone",
          "companyName",
          "gstin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["CUSTOMER", "SUPPLIER", "ADMIN"]
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "gstin": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": ["requestId"],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["success", "data", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [false]
          },
          "data": {
            "type": "object",
            "nullable": true
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
